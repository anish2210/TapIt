# Production client image: build the static bundle once, serve it with nginx.
# (packages/client/Dockerfile runs the Vite dev server and is for local use.)
#
# Build context is the tapcrm/ root, as for the other Dockerfiles.

FROM node:24-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/authz/package.json packages/authz/package.json
COPY packages/server/package.json packages/server/package.json
COPY packages/client/package.json packages/client/package.json
RUN npm ci

COPY . .
RUN npm run build
# The root build is `tsc --build` only; the static bundle comes from the client's
# own build script (`tsc --build && vite build`).
RUN npm run build --workspace @tapcrm/client

FROM nginx:1.27-alpine
# Drop the stock welcome page so a missing bundle fails loudly instead.
RUN rm -f /usr/share/nginx/html/index.html
COPY packages/client/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/client/dist /usr/share/nginx/html
EXPOSE 5173
